{
  "name": "snippetfy",
  "private": true,
  "version": "2.0.0",
  "description": "Snippetfy — nova stack (SPA + API)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @snippetfy/api exec prisma generate",
    "db:migrate": "pnpm --filter @snippetfy/api exec prisma migrate deploy",
    "db:migrate:dev": "pnpm --filter @snippetfy/api exec prisma migrate dev",
    "db:studio": "pnpm --filter @snippetfy/api exec prisma studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0"
}
